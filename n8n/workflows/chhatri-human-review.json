{
  "active": true,
  "nodes": [
    {
      "id": "webhook-trigger",
      "icon": "fa:code",
      "name": "Webhook Trigger",
      "position": [
        250,
        300
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "chhatri-human-review",
      "parameters": {
        "path": "chhatri-human-review",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "verify-secret",
      "icon": "fa:shield",
      "name": "Verify Secret Header",
      "position": [
        450,
        300
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $request.headers['x-chhatri-secret'] }}",
              "value2": "={{ $env['CHHATRI_INTERNAL_SECRET'] }}",
              "operation": "equals"
            }
          ]
        }
      }
    },
    {
      "id": "open-case",
      "icon": "fa:square",
      "name": "Open Case",
      "position": [
        650,
        200
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "parameters": {
        "url": "={{ $env['CHHATRI_PUBLIC_URL'] }}/internal/workflows/open_case",
        "method": "POST",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Chhatri-Secret",
              "value": "={{ $env['CHHATRI_INTERNAL_SECRET'] }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "body": "={{ JSON.stringify({ run_id: $request.body.run_id, workflow: 'human-review', step: 'open_case', payload: $request.body.payload }) }}"
      }
    },
    {
      "id": "notify-officer",
      "icon": "fa:square",
      "name": "Notify Officer",
      "position": [
        850,
        200
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "parameters": {
        "url": "={{ $env['CHHATRI_PUBLIC_URL'] }}/internal/workflows/notify_officer",
        "method": "POST",
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Chhatri-Secret",
              "value": "={{ $env['CHHATRI_INTERNAL_SECRET'] }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "body": "={{ JSON.stringify({ run_id: $request.body.run_id, workflow: 'human-review', step: 'notify_officer', payload: $request.body.payload }) }}"
      }
    },
    {
      "id": "respond-202",
      "icon": "fa:arrow-right",
      "name": "Respond 202",
      "position": [
        450,
        400
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "parameters": {
        "responseCode": 202,
        "responseBody": "={{ JSON.stringify({ ok: true, data: { status: 'queued' } }) }}"
      }
    },
    {
      "id": "error-response",
      "icon": "fa:times-circle",
      "name": "Respond 403 (secret mismatch)",
      "position": [
        650,
        400
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "parameters": {
        "responseCode": 403,
        "responseBody": "={{ JSON.stringify({ ok: false, error: { code: 'invalid_secret', message: 'X-Chhatri-Secret header mismatch' } }) }}"
      }
    }
  ],
  "connections": {
    "webhook-trigger": {
      "main": [
        [
          {
            "node": "verify-secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "verify-secret": {
      "main": [
        [
          {
            "node": "open-case",
            "type": "main",
            "index": 0
          },
          {
            "node": "respond-202",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "error-response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "open-case": {
      "main": [
        [
          {
            "node": "notify-officer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": null
}
