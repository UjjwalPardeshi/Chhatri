# Chhatri — environment variables (§21)
# Copy to .env and fill in your values. Never commit .env.
# Defaults are suitable for local development and demos.

# Core settings (SPEC §0, §14)
CHHATRI_SEED=20251019
CHHATRI_CONSOLE_ORIGIN=http://localhost:5173
CHHATRI_PUBLIC_URL=http://localhost:8000
# CHHATRI_OFFICER_TOKEN=  # auto-generated if not set (printed at startup)
# CHHATRI_INTERNAL_SECRET=  # auto-generated if not set
CHHATRI_DEMO_MODE=true
CHHATRI_LOG_LEVEL=INFO

# Sarvam AI (SPEC §14.1 — voice, chat, vision)
# Leave unset to use deterministic simulator
# SARVAM_API_KEY=  # your Sarvam API key
# Sarvam model settings (optional; defaults shown)
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ritu

# WhatsApp Cloud API (SPEC §14.2)
# Leave unset to use console phone simulator
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_DEMO_RECIPIENT=  # E.164 format; live messages go only to this number
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=hi

# Paytm payment links (SPEC §14.3)
# Option 1: MCP server (preferred)
# PAYTM_MCP_URL=http://localhost:8080/sse
# Option 2: Direct REST API (staging)
# PAYTM_MID=
# PAYTM_KEY_SECRET=
PAYTM_BASE_URL=https://securestage.paytmpayments.com
# Leave both unset to use simulated links (marked SIMULATED in UI)

# n8n workflows (SPEC §14.5)
# Leave unset to run workflows in-process (same logic, faster for demos)
# N8N_BASE_URL=http://localhost:5678
# N8N_ENCRYPTION_KEY=  (required for n8n container; auto-uses CHHATRI_INTERNAL_SECRET if unset)

# Cognee memory graph (SPEC §14.6 — optional)
COGNEE_ENABLED=false

# Open-Meteo live weather (SPEC §14.4)
# Leave false to use real cached fixtures for replay and backtest
OPENMETEO_LIVE=false
