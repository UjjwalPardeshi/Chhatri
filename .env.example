# Chhatri configuration (SPEC §0.1, §14, §21). Lists every field of backend/chhatri/config.py Settings
# plus the docker compose knobs. Copy to .env (`make env` does it and generates the two secrets marked
# GENERATED); .env is git-ignored and must never be committed. No real credentials belong in this file.
#
# Rules: leave a variable commented out to use the default. Never set a variable to an empty value
# unless this file says empty is allowed (an empty CHHATRI_OFFICER_TOKEN, for example, locks the
# officer routes). `make dev` reads this file from the repo root (Settings env_file ../.env);
# `docker compose` reads it for interpolation and passes the backend only the variables that are set.

# ---------------------------------------------------------------- core (SPEC §3, §19, §21)
CHHATRI_SEED=20251019
# Run state (audit SQLite per scenario load). Docker: /app/var (volume backend-var).
# CHHATRI_VAR_DIR=backend/var
# Committed inputs (geo, weather fixtures, slips). Artefacts are read from its sibling artifacts/.
# CHHATRI_DATA_DIR=backend/data
# CORS origin of the console. Dev: http://localhost:5173. Docker: http://localhost:$CHHATRI_CONSOLE_PORT
# (default 8080; the console is same-origin through nginx, so CORS rarely matters there).
# CHHATRI_CONSOLE_ORIGIN=http://localhost:5173
# URL at which n8n reaches the backend's /internal/workflows/{step}. Docker compose fixes it to
# http://backend:8000; for `make dev` with a separate n8n container use http://host.docker.internal:8000.
# CHHATRI_PUBLIC_URL=http://localhost:8000
# Officer bearer token. Unset: a random token is generated and logged at start-up, and in demo mode the
# console fetches it from GET /api/session. Set it (non-empty) to fix the token.
# CHHATRI_OFFICER_TOKEN=
# GENERATED by `make env`. Shared by the backend and n8n (X-Chhatri-Secret on /internal/* and on the
# n8n webhooks). Required by docker compose. Empty = every internal call is refused.
CHHATRI_INTERNAL_SECRET=
# Demo mode: GET /api/session hands the officer token to the console (turn off outside a demo).
CHHATRI_DEMO_MODE=true
CHHATRI_LOG_LEVEL=INFO
# Feature flags (Wave 0), comma-separated, e.g. CHHATRI_FEATURES=n1_miniapp,n2_ask_chhatri. Unset: every flag
# is OFF, a flagged route answers 404 not_found and the console hides the feature. The names are listed in
# backend/chhatri/features.py (n1_miniapp n2_ask_chhatri n3_slip_precheck n4_voice n5_grievances n6_consents
# n8_marathi x4_lender_request x6_provider_panel x8_distress_guard h8_ops_strip h24_whatif h25_evals
# console_polish telegram_channel). Docker compose passes the same list to the console build (VITE_FEATURES, below).
# CHHATRI_FEATURES=
# EDI holiday (X4, flag x4_lender_request): seconds Chhatri waits for the lender's answer. One attempt, no retry:
# no answer in time means "could not reach your lender" and the instalment stays due. Default 10.
# CHHATRI_LENDER_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- Sarvam (SPEC §14.1): STT, TTS, chat, vision
# Unset: deterministic simulator (labelled SIMULATED). Set: all four Sarvam components go LIVE.
# SARVAM_API_KEY=
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=ritu

# ---------------------------------------------------------------- Gemini (Google AI Studio free tier): chat and vision
# Gemini is tried first, then Sarvam, then a catalogue template or the simulated slip reader (ADR 0003). A Gemini link
# needs the key AND a model id: a key alone leaves Gemini out and the provider panel says "key set, model not set".
# No model id has a default because the free-tier ids change: `make check-keys` lists the ones this key can call.
# GEMINI_VISION_MODEL is optional: a model that accepts images, for the slip reader (default: GEMINI_MODEL).
# GOOGLE_API_KEY=
# GEMINI_MODEL=
# GEMINI_VISION_MODEL=

# ---------------------------------------------------------------- free-tier data gate (ADR 0009)
# Only synthetic data may be sent to an AI service on a free tier (Gemini, Sarvam credits). This line is this
# deployment's declaration that all its data is synthetic, as in the prototype. Unset or not true: every free-tier AI
# link is skipped (labelled SIMULATED, FREE_TIER_BLOCKED) and templates and simulators answer. Never set it to true
# where real merchants' or patients' data is held.
CHHATRI_DATA_IS_SYNTHETIC=true

# ---------------------------------------------------------------- WhatsApp Cloud API (SPEC §14.2)
# LIVE only when the first four are all set; otherwise the in-console phone simulator.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# The only number live messages are ever sent to (E.164, e.g. +9198xxxxxxxx); demo merchants only.
# WHATSAPP_DEMO_RECIPIENT=
# WHATSAPP_GRAPH_VERSION=v25.0
# WHATSAPP_TEMPLATE_LANGUAGE=hi

# ---------------------------------------------------------------- Telegram bot (flag telegram_channel)
# A bot made with @BotFather. LIVE when the token is set AND CHHATRI_DATA_IS_SYNTHETIC=true (ADR 0009); otherwise the
# in-console Telegram simulator. The bot receives messages by long polling (getUpdates): no webhook, no public URL.
# A demo merchant's chat is bound with the link https://t.me/<bot username>?start=S-0142 (/stop unbinds); only demo
# merchants are ever bound. `make check-keys` shows SET / NOT SET and the bot's username, never the token.
# TELEGRAM_BOT_TOKEN=
# Poll for incoming messages while the token is set (default true); false = send only.
# TELEGRAM_POLLING=true

# ---------------------------------------------------------------- Paytm payment link (SPEC §14.3)
# MCP server over SSE (preferred), e.g. http://localhost:8080/sse (docker: http://host.docker.internal:8080/sse)
# PAYTM_MCP_URL=
# Or direct REST with checksum (staging):
# PAYTM_MID=
# PAYTM_KEY_SECRET=
# PAYTM_BASE_URL=https://securestage.paytmpayments.com
# Neither set: simulated links https://paytm.me/sim-XXXXXX, labelled SIMULATED.

# ---------------------------------------------------------------- n8n (SPEC §14.5, §15)
# `make dev` only: set to use a running n8n (e.g. http://localhost:5678); unset = in-process runner.
# Docker compose ignores this and wires the backend to http://n8n:5678 (see CHHATRI_STACK_N8N_URL).
# N8N_BASE_URL=

# ---------------------------------------------------------------- memory, weather (SPEC §14.4, §14.6)
COGNEE_ENABLED=false
OPENMETEO_LIVE=false

# ---------------------------------------------------------------- docker compose only (make up)
# GENERATED by `make env`. n8n's credential encryption key (kept in the n8n-data volume's config).
N8N_ENCRYPTION_KEY=
# Host interface and ports of the stack.
# CHHATRI_BIND_ADDR=127.0.0.1
# CHHATRI_BACKEND_PORT=8000
# CHHATRI_CONSOLE_PORT=8080
# CHHATRI_N8N_PORT=5678
# Backend -> n8n URL inside the stack. Unset: http://n8n:5678 (n8n LIVE). Empty value: in-process runner.
# n8n LIVE holds the monsoon replay at 17:00 for about 30-60 s while 312 payout runs go through n8n
# (docs/DEMO.md); the in-process runner does it in about a second.
# CHHATRI_STACK_N8N_URL=
# Console basemap (build argument of the frontend image; for `make dev` put it in frontend/.env.local).
# Empty: keyless CARTO is probed and the designed no-tile map is used (CARTO now needs a key).
# VITE_TILE_URL=

# ---------------------------------------------------------------- console (frontend/.env.local, `make dev`)
# Vite reads VITE_* from frontend/ (not from this file) or the shell:
# VITE_API_URL=http://localhost:8000   dev-server /api proxy target (`make dev` sets it from BACKEND_PORT)
# VITE_MOCK=1                          in-browser mock backend (`npm run dev:mock`, or ?mock=1)
# VITE_FEATURES=n1_miniapp,n2_ask_chhatri   feature flags that are on in the console (same names as
#                                      CHHATRI_FEATURES; default none). `make dev`: shell or frontend/.env.local;
#                                      mock mode: shell or frontend/.env.mock.local; docker: a console build
#                                      argument that defaults to CHHATRI_FEATURES.
